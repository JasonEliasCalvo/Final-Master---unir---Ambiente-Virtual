  sectionDataList:
  - sectionId: a8cd785c-5e78-11f0-b70b-42010a7be01f
    sectionName: Estatuas
    behaviorTreeConstants: 
    objective: "Explicar las estatuas y sus detalles hist\xF3ricos de manera simple
      y preguntar si quiere profundizar en alg\xFAn tema.\n\nSi la respuesta del
      usuario no es una respuesta a la pregunta anterior, responda la pregunta del
      usuario y preg\xFAntele si tiene alguna pregunta."
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: b15c623a-5e78-11f0-804f-42010a7be01f
    sectionName: Figuras Geometricas
    behaviorTreeConstants: 
    objective: "Explicar las figuras geom\xE9tricas, su rol art\xEDstico y matem\xE1tico
      de manera simple y preguntar si quiere profundizar en alg\xFAn tema.\n\nSi
      la respuesta del usuario no es una respuesta a la pregunta anterior, responda
      la pregunta del usuario y preg\xFAntele si tiene alguna pregunta."
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 47a6c828-5e6c-11f0-b5d4-42010a7be01f
    sectionName: Presentacion
    behaviorTreeConstants: 
    objective: "Dar la bienvenida emocionado y preg\xFAntale si est\xE1 listo para
      hacer el recorrido, tambi\xE9n da sugerencias como dar las opciones de o\xEDr
      la historia o explicarle las instalaciones antes de iniciar."
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 3051a0be-5e79-11f0-a4bd-42010a7be01f
    sectionName: Final
    behaviorTreeConstants: 
    objective: Agradecer al visitante por su tiempo
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 12b33cf8-5e78-11f0-83e2-42010a7be01f
    sectionName: historia
    behaviorTreeConstants: 
    objective: "Explicar el origen y raz\xF3n del museo, luego preguntar si quiere
      saber m\xE1s o ir a las secciones.\n\nSi la respuesta del usuario no es una
      respuesta a la pregunta anterior, responda la pregunta del usuario y preg\xFAntele
      si tiene alguna pregunta."
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 3b4a1934-5e78-11f0-8122-42010a7be01f
    sectionName: instalaciones
    behaviorTreeConstants: 
    objective: "Mostrar qu\xE9 contiene el museo y preguntar a qu\xE9 secci\xF3n
      desea ir.\n\nSi la respuesta del usuario no es una respuesta a la pregunta
      anterior, responda la pregunta del usuario y preg\xFAntele si tiene alguna
      pregunta."
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 05db037e-617c-11f0-8f6d-42010a7be01f
    sectionName: Ir_Hacia_Estatuas
    behaviorTreeConstants: 
    objective: "Ir hacia la secci\xF3n de estatuas del museo"
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 8aefe6f4-6179-11f0-8298-42010a7be01f
    sectionName: Ir_Al_Final
    behaviorTreeConstants: 
    objective: Ir hacia la salida del museo
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - sectionId: 8b8f5a84-617b-11f0-b48e-42010a7be01f
    sectionName: Ir_Hacia_FigurasGeometricas
    behaviorTreeConstants: 
    objective: "Ir hacia la secci\xF3n de figuras geom\xE9tricas del museo"
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  triggerDataList:
  - triggerId: 1d55c5b8-5e78-11f0-bde8-42010a7be01f
    triggerName: welcomeTrigger
    triggerMessage: "\xA1Bienvenido al Museo Internacional de Historia y Forma! Soy
      Arturo, tu gu\xEDa digital. \xBFQu\xE9 deseas conocer primero: la historia
      del museo o nuestras instalaciones?"
    destinationSection: 47a6c828-5e6c-11f0-b5d4-42010a7be01f
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - triggerId: e2791cd6-617b-11f0-b48e-42010a7be01f
    triggerName: Estatuas_Trigger
    triggerMessage: "El usuario llego a la secci\xF3n de estatuas"
    destinationSection: 
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - triggerId: a4cd641a-617a-11f0-abc3-42010a7be01f
    triggerName: Final_Trigger
    triggerMessage: El usuario ha llegado al final.
    destinationSection: 
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
  - triggerId: 6012b6c6-617b-11f0-9c54-42010a7be01f
    triggerName: Figuras_Trigger
    triggerMessage: "El usuario ha llegado a la secci\xF3n de figuras."
    destinationSection: 
    characterId: 3b5955c2-5e6c-11f0-804f-42010a7be01f
